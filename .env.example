# Copy to .env and fill in. .env is git-ignored: never commit real values.
# Generate strong values with:  openssl rand -hex 24

# --- PostgreSQL (operational data) ---
# Four separate accounts, four different passwords (see docker/postgres/provision.sh).
# Administrator: schema migrations and backups only; no service runs with it.
POSTGRES_USER=qts_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qts
# The platform itself (role qts_app): reads and writes data, cannot change the schema.
QTS_APP_DB_PASSWORD=change-me-app
# Freqtrade's own database (role freqtrade_app). Hex characters only.
FREQTRADE_DB_PASSWORD=change-me-freqtrade
# Grafana (role grafana_ro): read-only.
GRAFANA_DB_PASSWORD=change-me-grafana

# --- Backups (service backup-scheduler) ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# --- Platform ---
# Inside docker compose the connection is built from the values above. Set these
# only when running the CLI on the host against the stack's database (default
# without them: local SQLite in ./state). QTS_DB_PASSWORD_FILE=/path reads the
# password from a file (Docker secret) instead.
# QTS_DB_HOST=127.0.0.1
# QTS_DB_NAME=qts
# QTS_DB_USER=qts_app
# QTS_DB_PASSWORD=change-me-app
QTS_LOG_LEVEL=INFO
QTS_LOG_JSON=true

# Live trading is NOT implemented in this version. These switches exist so the
# refusal is explicit; leaving them as they are is the only supported setting.
QTS_ENABLE_LIVE_TRADING=false
QTS_LIVE_TRADING_CONFIRMATION=

# Exchange API keys are not needed for backtesting or paper trading.
# Leave empty. Never paste real keys here without a conscious decision to go live.
QTS_EXCHANGE_API_KEY=
QTS_EXCHANGE_API_SECRET=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Freqtrade dry-run API/UI (only for `--profile freqtrade`) ---
FREQTRADE_API_USERNAME=qts
FREQTRADE_API_PASSWORD=change-me
# at least 32 characters
FREQTRADE_JWT_SECRET=change-me-change-me-change-me-change-me
