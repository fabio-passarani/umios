# Copy to .env and fill in. .env is git-ignored: never commit real values.
# Generate strong values with:  openssl rand -hex 24

# --- PostgreSQL (operational data) ---
POSTGRES_USER=qts
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qts
GRAFANA_DB_PASSWORD=change-me-too

# --- Platform ---
# Inside docker compose the URL is built from the values above; set this only
# when running the CLI on the host (default without it: local SQLite in ./state).
# QTS_DATABASE_URL=postgresql://qts:change-me@127.0.0.1:5432/qts
QTS_LOG_LEVEL=INFO
QTS_LOG_JSON=true

# Live trading is NOT implemented in this version. These switches exist so the
# refusal is explicit; leaving them as they are is the only supported setting.
QTS_ENABLE_LIVE_TRADING=false
QTS_LIVE_TRADING_CONFIRMATION=

# Exchange API keys are not needed for backtesting or paper trading.
# Leave empty. Never paste real keys here without a conscious decision to go live.
QTS_EXCHANGE_API_KEY=
QTS_EXCHANGE_API_SECRET=

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# --- Freqtrade dry-run API/UI (only for `--profile freqtrade`) ---
FREQTRADE_API_USERNAME=qts
FREQTRADE_API_PASSWORD=change-me
# at least 32 characters
FREQTRADE_JWT_SECRET=change-me-change-me-change-me-change-me
