  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "qts-postgres"
        },
        "query": "SELECT kind || ' | ' || strategy || ' | ' || to_char(started_at, 'YYYY-MM-DD HH24:MI') || ' | ' || status AS __text, id AS __value FROM runs ORDER BY (kind = 'paper' AND status = 'running') DESC, started_at DESC",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {}
      }
    ]
