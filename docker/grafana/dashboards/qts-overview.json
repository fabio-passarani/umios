  "title": "QTS \u2014 Trading overview",
  "tags": [
    "qts"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-10y",
    "to": "now"
